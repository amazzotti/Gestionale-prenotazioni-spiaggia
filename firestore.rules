rules_version = '2';

// Regole di sicurezza Firestore per il Gestionale Spiaggia.
// Da incollare in Firebase Console -> Firestore Database -> Regole -> Pubblica.
//
// Chi può entrare: solo gli account Firebase Auth la cui email (in minuscolo)
// è l'ID di un documento nella collezione `utenti`, con campo `ruolo`:
//   - 'admin' -> tutto, compresi editor mappa e reset stagione
//   - 'staff' -> prenotazioni e arrivi
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInWithEmail() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isStaff() {
      return signedInWithEmail()
        && exists(/databases/$(database)/documents/utenti/$(userEmail()));
    }

    function isAdmin() {
      return isStaff()
        && get(/databases/$(database)/documents/utenti/$(userEmail())).data.ruolo == 'admin';
    }

    function optionalString(d, field, maxLen) {
      return !(field in d) || (d[field] is string && d[field].size() <= maxLen);
    }

    function optionalBool(d, field) {
      return !(field in d) || d[field] is bool;
    }

    function optionalAmount(d, field) {
      return !(field in d) || d[field] == null || (d[field] is number && d[field] >= 0 && d[field] < 1000000);
    }

    // Una prenotazione valida: solo campi conosciuti, tipi giusti, fine >= inizio.
    function validBooking(d) {
      return d.keys().hasAll(['umbrellaId', 'clientName', 'startDate', 'endDate'])
        && d.keys().hasOnly(['umbrellaId', 'clientName', 'startDate', 'endDate', 'notes', 'arrived',
                             'phone', 'price', 'deposit', 'paid', 'createdAt', 'updatedAt', 'updatedBy'])
        && d.umbrellaId is string && d.umbrellaId.size() > 0 && d.umbrellaId.size() <= 40
        && d.clientName is string && d.clientName.size() > 0 && d.clientName.size() <= 100
        && d.startDate is timestamp && d.endDate is timestamp && d.startDate <= d.endDate
        && optionalString(d, 'notes', 500)
        && optionalString(d, 'phone', 30)
        && optionalString(d, 'updatedBy', 254)
        && optionalBool(d, 'arrived')
        && optionalBool(d, 'paid')
        && optionalAmount(d, 'price')
        && optionalAmount(d, 'deposit');
    }

    match /bookings/{bookingId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff() && validBooking(request.resource.data);
    }

    match /beachLayout/{sectorId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /meta/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Ognuno può leggere solo il proprio ruolo. Gli utenti si aggiungono
    // dalla console Firebase, mai dall'app.
    match /utenti/{email} {
      allow read: if signedInWithEmail() && email == userEmail();
      allow write: if false;
    }

    // Tutto il resto è chiuso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
